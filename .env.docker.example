# ApexGrid-F1 Docker Environment Variables Example
# Copy to .env or use with Docker Compose

# Ports exposed on host machine
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Backend Configuration
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "https://yourdomain.com"]

# Frontend Configuration (Used during Docker build)
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_SITE_NAME=ApexGrid F1
NEXT_PUBLIC_ACCENT_COLOR=#D2FF00
NEXT_PUBLIC_USE_MOCK_FALLBACK=true

# ==============================================================================
# ApexGrid F1 - Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
jspm_packages/
web_modules/
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# Next.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
.next/
**/.next/
out/
build/
dist/
.vercel
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts.bak

# ------------------------------------------------------------------------------
# Python & Backend Artifacts
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
**/.venv/
**/venv/

# Testing & Coverage
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# FastF1 / Data Caches
cache/
**/cache/
*.h5
*.pkl
*.parquet
*.feather
*.sqlite3
*.db

# ------------------------------------------------------------------------------
# Logs & Debugging
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable

.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Scratch & Temporary Files
# ------------------------------------------------------------------------------
tmp/
temp/
scratch/
.temp/
